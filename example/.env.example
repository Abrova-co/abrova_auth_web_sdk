# Copy to .env and set your project's PUBLIC API key (Abrova Console > your project > API keys).
# Only the public key (ab_live_...) belongs in a browser app. Never put the server secret (ab_srv_...) here.
VITE_ABROVA_API_KEY=ab_live_YOUR_PUBLIC_KEY
# Optional: another Auth server, for example one you run yourself. Leave unset for the default server.
# VITE_ABROVA_AUTH_URL=
